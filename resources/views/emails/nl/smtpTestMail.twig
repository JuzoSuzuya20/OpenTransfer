{% extends 'emails/layout' %}

{% block subject %}Test-e-mail van {{ settings.application_name }}{% endblock %}

{% block header %}Mailserver{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Dit bericht is verstuurd vanuit Beheer > Mailserver van {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Het is aangekomen: de server <strong>{{ host }}</strong> kan de e-mails van de toepassing versturen.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Niets getest? Misschien deed een andere beheerder het voor u. U kunt dit bericht negeren.</p>
{% endblock %}
