{% extends 'emails/layout' %}

{% block subject %}Test-e-mail van {{ settings.application_name }}{% endblock %}

{% block header %}Mailserver{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Hallo {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Dit bericht is verstuurd vanuit Beheer > Mailserver van {{ settings.application_name }}.</p>
<p style="margin:0 0 4px;">Het is aangekomen. Deze server kan de e-mails van de toepassing versturen:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#f6f6f6" style="padding:10px 14px;background:#f6f6f6;border:1px solid #cecece;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#161616;">{% for part in hostParts %}{{ part }}{% if not loop.last %}.<wbr>{% endif %}{% endfor %}</td></tr></table>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#666666;">Niets getest? Misschien deed een andere beheerder het voor u. U kunt dit bericht negeren.</p>
{% endblock %}
