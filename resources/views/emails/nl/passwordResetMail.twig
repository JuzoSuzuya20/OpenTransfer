{% extends 'emails/layout' %}

{% block subject %}Je wachtwoord opnieuw instellen{% endblock %}

{% block header %}Wachtwoord{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 10px;">We hebben een verzoek ontvangen om je wachtwoord opnieuw in te stellen.</p>
<p style="margin:0 0 10px;">Met de knop hieronder kies je een nieuw wachtwoord.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Heb je niets gevraagd? Negeer deze e-mail: je wachtwoord verandert niet.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Nieuw wachtwoord kiezen{% endblock %}
