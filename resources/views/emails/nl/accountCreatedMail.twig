{% extends 'emails/layout' %}

{% block subject %}Je account bij {{ settings.application_name }} is klaar{% endblock %}

{% block header %}Account aangemaakt{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 10px;">Er is een account voor je aangemaakt bij {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Kies je wachtwoord om te beginnen.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Mijn wachtwoord kiezen{% endblock %}
