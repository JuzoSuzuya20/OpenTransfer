{% extends 'emails/layout' %}

{% block subject %}Je share is verlopen{% endblock %}

{% block header %}Share verlopen{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">Je share „{{ share.name }}” is verlopen.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;">
  <tr><td style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#929292;">Downloads</td><td align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#ffffff;">{{ share.download_count }}</td></tr>
</table>
<p style="margin:0 0 10px;">Je kunt hem verlengen via Mijn shares.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Mijn shares openen{% endblock %}
