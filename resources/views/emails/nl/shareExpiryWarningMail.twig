{% extends 'emails/layout' %}

{% block subject %}Je share verloopt binnenkort{% endblock %}

{% block header %}Verloopt binnenkort{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">Je share „{{ share.name }}” verloopt over {{ share_expires_in }}.</p>
<p style="margin:0 0 12px;">Verleng hem zo nodig via Mijn shares.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Mijn shares openen{% endblock %}
