{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} vraagt je om bestanden{% endblock %}

{% block header %}Bestandsverzoek{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ recipient_name }},</h2>
<p style="margin:0 0 10px;">{{ sender_name }} vraagt je om bestanden te sturen.</p>
{% if isExistingUser %}<p style="margin:0 0 10px;">Meld je aan om ze te uploaden.</p>{% else %}<p style="margin:0 0 10px;">Accepteer het verzoek om ze te uploaden, zonder account.</p>{% endif %}
{% if invite.message %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;"><tr><td style="padding:16px 0 0;"><p style="margin:0 0 8px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Bericht van {{ sender_name }}</p><p style="margin:0;color:#cecece;">{{ invite.message|nl2br }}</p></td></tr></table>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Aanmelden en uploaden{% else %}Verzoek accepteren{% endif %}{% endblock %}
