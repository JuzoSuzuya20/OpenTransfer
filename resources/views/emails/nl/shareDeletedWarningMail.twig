{% extends 'emails/layout' %}

{% block subject %}Je share is verwijderd{% endblock %}

{% block header %}Share verwijderd{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">Je share „{{ share.name }}” is verwijderd.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 4px;border-collapse:separate;border-spacing:0;">
  <tr><td bgcolor="#242424" style="background:#242424;padding:10px 14px;font-size:12px;color:#929292;">Downloads</td><td bgcolor="#242424" align="right" style="background:#242424;padding:10px 14px;font-size:14px;font-weight:800;color:#ffffff;">{{ share.download_count }}</td></tr>
</table>
<p style="margin:0 0 12px;">Hij kan niet meer worden hersteld.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}{% endblock %}

{% block action_text %}{{ settings.application_name }} openen{% endblock %}
