{% extends 'emails/layout' %}

{% block subject %}Je share is gedownload{% endblock %}

{% block header %}Share gedownload{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">Je share „{{ share.name }}” is zojuist gedownload.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Deze e-mail wordt alleen bij de eerste download verstuurd.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Share bekijken{% endblock %}
