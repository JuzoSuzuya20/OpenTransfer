{% extends 'emails/layout' %}

{% block subject %}Je verificatiecode{% endblock %}

{% block header %}Adres bevestigen{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Bedankt voor het aanmaken van een account bij {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Voer deze code in om je account te activeren:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#242424" style="padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</td></tr></table>
<p style="margin:0 0 10px;">Deze code verloopt over 15 minuten.</p>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Heb je geen account aangemaakt? Dan kun je deze e-mail negeren.</p>
{% endblock %}
