{% extends 'emails/layout' %}

{% block subject %}Je verificatiecode{% endblock %}

{% block header %}Adres bevestigen{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 12px;">Bedankt voor het aanmaken van een account bij {{ settings.application_name }}.</p>
<p style="margin:0 0 12px;">Voer deze code in om je account te activeren:</p>
<p style="margin:20px 0;text-align:center;"><span style="display:inline-block;padding:16px 28px;background:#242424;border:1px solid #353535;border-radius:6px;font-size:30px;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 12px;">Deze code verloopt over 15 minuten.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Heb je geen account aangemaakt? Dan kun je deze e-mail negeren.</p>
{% endblock %}
