{% extends 'emails/layout' %}

{% block subject %}A sua partilha foi transferida{% endblock %}

{% block header %}Partilha transferida{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Olá, {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">A sua partilha «{{ share.name }}» acabou de ser transferida.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Este e-mail só é enviado na primeira transferência.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Ver a partilha{% endblock %}
