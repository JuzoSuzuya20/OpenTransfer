{% extends 'emails/layout' %}

{% block subject %}Repor a sua palavra-passe{% endblock %}

{% block header %}Palavra-passe{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Olá, {{ user.name }},</h2>
<p style="margin:0 0 12px;">Recebemos um pedido para repor a sua palavra-passe.</p>
<p style="margin:0 0 12px;">O botão abaixo permite escolher uma nova.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Não pediu nada? Ignore este e-mail: a sua palavra-passe não muda.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Escolher uma nova palavra-passe{% endblock %}
