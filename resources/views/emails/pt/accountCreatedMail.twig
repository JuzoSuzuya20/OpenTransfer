{% extends 'emails/layout' %}

{% block subject %}A sua conta {{ settings.application_name }} está pronta{% endblock %}

{% block header %}Conta criada{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Olá, {{ user.name }},</h2>
<p style="margin:0 0 10px;">Foi criada uma conta para si em {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Escolha a sua palavra-passe para começar.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Escolher a palavra-passe{% endblock %}
