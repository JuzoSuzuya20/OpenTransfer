{% extends 'emails/layout' %}

{% block subject %}O seu código de verificação{% endblock %}

{% block header %}Verificação do endereço{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Olá, {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Obrigado por criar uma conta em {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Introduza este código para ativar a sua conta:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#f6f6f6" style="padding:14px 22px;background:#f6f6f6;border:1px solid #cecece;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#161616;">{{ code }}</td></tr></table>
<p style="margin:0 0 10px;">Este código expira em 15 minutos.</p>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#666666;">Não criou nenhuma conta? Pode ignorar este e-mail.</p>
{% endblock %}
