{% extends 'emails/layout' %}

{% block subject %}O seu código de verificação{% endblock %}

{% block header %}Verificação do endereço{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Olá, {{ user.name }},</h2>
<p style="margin:0 0 10px;">Obrigado por criar uma conta em {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Introduza este código para ativar a sua conta:</p>
<p style="margin:20px 0;"><span style="display:inline-block;padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 10px;">Este código expira em 15 minutos.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Não criou nenhuma conta? Pode ignorar este e-mail.</p>
{% endblock %}
