{% extends 'emails/layout' %}

{% block subject %}A sua partilha expira em breve{% endblock %}

{% block header %}Expiração em breve{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Olá, {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">A sua partilha «{{ share.name }}» expira dentro de {{ share_expires_in }}.</p>
<p style="margin:0 0 10px;">Prolongue-a em As minhas partilhas, se necessário.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Abrir As minhas partilhas{% endblock %}
