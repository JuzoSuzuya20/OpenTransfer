{% extends 'emails/layout' %}

{% block subject %}E-mail de teste de {{ settings.application_name }}{% endblock %}

{% block header %}Servidor de e-mail{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Olá, {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Esta mensagem foi enviada a partir de Administração > Servidor de e-mail de {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Chegou: o servidor <strong style="color:#ffffff;">{{ host }}</strong> pode enviar os e-mails da aplicação.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Não testou nada? Talvez outro administrador o tenha feito por si. Pode ignorar esta mensagem.</p>
{% endblock %}
