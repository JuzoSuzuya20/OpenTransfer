{% extends 'emails/layout' %}

{% block subject %}Su envío se ha eliminado{% endblock %}

{% block header %}Envío eliminado{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hola, {{ share.user.first_name }}:</h2>
<p style="margin:0 0 10px;">Su envío «{{ share.name }}» se ha eliminado.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;">
  <tr><td style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#929292;">Descargas</td><td align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#ffffff;">{{ share.download_count }}</td></tr>
</table>
<p style="margin:0 0 10px;">Ya no se puede restaurar.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}{% endblock %}

{% block action_text %}Abrir {{ settings.application_name }}{% endblock %}
