{% extends 'emails/layout' %}

{% block subject %}Restablecer su contraseña{% endblock %}

{% block header %}Contraseña{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hola, {{ user.name }}:</h2>
<p style="margin:0 0 10px;">Hemos recibido una solicitud para restablecer su contraseña.</p>
<p style="margin:0 0 10px;">El botón de abajo le permite elegir una nueva.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">¿No ha solicitado nada? Ignore este mensaje: su contraseña no cambia.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Elegir una nueva contraseña{% endblock %}
