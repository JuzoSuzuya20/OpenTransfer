{% extends 'emails/layout' %}

{% block subject %}Su código de verificación{% endblock %}

{% block header %}Verificación de la dirección{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hola, {{ user.name }}:</h2>
<p style="margin:0 0 12px;">Gracias por crear una cuenta en {{ settings.application_name }}.</p>
<p style="margin:0 0 12px;">Introduzca este código para activar su cuenta:</p>
<p style="margin:20px 0;text-align:center;"><span style="display:inline-block;padding:16px 28px;background:#242424;border:1px solid #353535;border-radius:6px;font-size:30px;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 12px;">Este código caduca en 15 minutos.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">¿No ha creado ninguna cuenta? Puede ignorar este mensaje.</p>
{% endblock %}
