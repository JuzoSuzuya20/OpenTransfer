{% extends 'emails/layout' %}

{% block subject %}Su cuenta de {{ settings.application_name }} está lista{% endblock %}

{% block header %}Cuenta creada{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hola, {{ user.name }}:</h2>
<p style="margin:0 0 10px;">Se ha creado una cuenta para usted en {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Elija su contraseña para empezar.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Elegir mi contraseña{% endblock %}
