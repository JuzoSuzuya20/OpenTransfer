{% extends 'emails/layout' %}

{% block subject %}Correo de prueba de {{ settings.application_name }}{% endblock %}

{% block header %}Servidor de correo{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hola, {{ user.first_name }}:</h2>
<p style="margin:0 0 10px;">Este mensaje se ha enviado desde Administración > Servidor de correo de {{ settings.application_name }}.</p>
<p style="margin:0 0 4px;">Ha llegado. Este servidor puede enviar los correos de la aplicación:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td bgcolor="#242424" style="padding:10px 14px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#ffffff;">{% for part in hostParts %}{{ part }}{% if not loop.last %}.<wbr>{% endif %}{% endfor %}</td></tr></table>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">¿No ha probado nada? Quizá otro administrador lo hizo por usted. Puede ignorar este mensaje.</p>
{% endblock %}
