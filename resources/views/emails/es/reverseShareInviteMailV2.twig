{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} le solicita archivos{% endblock %}

{% block header %}Solicitud de archivos{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hola, {{ recipient_name }}:</h2>
<p style="margin:0 0 12px;">{{ sender_name }} le pide que le envíe archivos.</p>
{% if isExistingUser %}<p style="margin:0 0 12px;">Inicie sesión para depositarlos.</p>{% else %}<p style="margin:0 0 12px;">Acepte la solicitud para depositarlos, sin crear una cuenta.</p>{% endif %}
{% if invite.message %}<div style="margin:16px 0 4px;padding:12px 14px;background:#242424;border-left:3px solid #6a6af4;border-radius:0 6px 6px 0;"><p style="margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Mensaje de {{ sender_name }}</p><p style="margin:0;white-space:pre-line;color:#cecece;">{{ invite.message }}</p></div>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Iniciar sesión y depositar{% else %}Aceptar la solicitud{% endif %}{% endblock %}
