{% extends 'emails/layout' %}

{% block subject %}Confirme su nueva dirección{% endblock %}

{% block header %}Nueva dirección{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hola, {{ user.name }}:</h2>
<p style="margin:0 0 10px;">Ha pedido usar esta dirección para su cuenta en {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Introduzca este código en su perfil para confirmarla:</p>
<p style="margin:20px 0;"><span style="display:inline-block;padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 10px;">Este código caduca en 15 minutos. Hasta entonces, su cuenta conserva su dirección actual.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">¿No lo ha pedido usted? Ignore este mensaje: no cambia nada.</p>
{% endblock %}
