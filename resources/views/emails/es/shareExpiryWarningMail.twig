{% extends 'emails/layout' %}

{% block subject %}Su envío caduca pronto{% endblock %}

{% block header %}Caducidad próxima{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hola, {{ share.user.first_name }}:</h2>
<p style="margin:0 0 12px;">Su envío «{{ share.name }}» caduca dentro de {{ share_expires_in }}.</p>
<p style="margin:0 0 12px;">Amplíelo desde Mis envíos si es necesario.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Abrir Mis envíos{% endblock %}
