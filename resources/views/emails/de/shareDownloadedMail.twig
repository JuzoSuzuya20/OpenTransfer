{% extends 'emails/layout' %}

{% block subject %}Ihre Freigabe wurde heruntergeladen{% endblock %}

{% block header %}Freigabe heruntergeladen{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">Ihre Freigabe „{{ share.name }}“ wurde gerade heruntergeladen.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Diese E-Mail wird nur beim ersten Download gesendet.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Freigabe ansehen{% endblock %}
