{% extends 'emails/layout' %}

{% block subject %}Passwort zurücksetzen{% endblock %}

{% block header %}Passwort{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 12px;">Wir haben eine Anfrage zum Zurücksetzen Ihres Passworts erhalten.</p>
<p style="margin:0 0 12px;">Über die Schaltfläche unten wählen Sie ein neues.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Sie haben nichts angefragt? Ignorieren Sie diese E-Mail: Ihr Passwort bleibt unverändert.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Neues Passwort wählen{% endblock %}
