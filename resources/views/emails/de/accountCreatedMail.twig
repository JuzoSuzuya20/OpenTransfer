{% extends 'emails/layout' %}

{% block subject %}Ihr Konto bei {{ settings.application_name }} ist bereit{% endblock %}

{% block header %}Konto erstellt{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 10px;">Für Sie wurde ein Konto bei {{ settings.application_name }} erstellt.</p>
<p style="margin:0 0 10px;">Wählen Sie Ihr Passwort, um zu beginnen.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Passwort wählen{% endblock %}
