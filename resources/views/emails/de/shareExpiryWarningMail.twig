{% extends 'emails/layout' %}

{% block subject %}Ihre Freigabe läuft bald ab{% endblock %}

{% block header %}Ablauf bald{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">Ihre Freigabe „{{ share.name }}“ läuft in {{ share_expires_in }} ab.</p>
<p style="margin:0 0 10px;">Verlängern Sie sie bei Bedarf unter Meine Freigaben.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Meine Freigaben öffnen{% endblock %}
