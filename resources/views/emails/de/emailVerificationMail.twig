{% extends 'emails/layout' %}

{% block subject %}Ihr Bestätigungscode{% endblock %}

{% block header %}Adresse bestätigen{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 12px;">Danke, dass Sie ein Konto bei {{ settings.application_name }} erstellt haben.</p>
<p style="margin:0 0 12px;">Geben Sie diesen Code ein, um Ihr Konto zu aktivieren:</p>
<p style="margin:20px 0;text-align:center;"><span style="display:inline-block;padding:16px 28px;background:#242424;border:1px solid #353535;border-radius:6px;font-size:30px;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 12px;">Dieser Code läuft in 15 Minuten ab.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Sie haben kein Konto erstellt? Dann können Sie diese E-Mail ignorieren.</p>
{% endblock %}
