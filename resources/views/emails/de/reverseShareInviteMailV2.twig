{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} bittet Sie um Dateien{% endblock %}

{% block header %}Dateianfrage{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ recipient_name }},</h2>
<p style="margin:0 0 10px;">{{ sender_name }} bittet Sie, Dateien zu senden.</p>
{% if isExistingUser %}<p style="margin:0 0 10px;">Melden Sie sich an, um sie hochzuladen.</p>{% else %}<p style="margin:0 0 10px;">Nehmen Sie die Anfrage an, um sie hochzuladen, ohne Konto.</p>{% endif %}
{% if invite.message %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;"><tr><td style="padding:16px 0 0;"><p style="margin:0 0 8px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Nachricht von {{ sender_name }}</p><p style="margin:0;color:#cecece;">{{ invite.message|nl2br }}</p></td></tr></table>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Anmelden und hochladen{% else %}Anfrage annehmen{% endif %}{% endblock %}
