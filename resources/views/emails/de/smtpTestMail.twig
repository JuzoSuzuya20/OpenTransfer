{% extends 'emails/layout' %}

{% block subject %}Test-E-Mail von {{ settings.application_name }}{% endblock %}

{% block header %}E-Mail-Server{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Hallo {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Diese Nachricht wurde unter Administration > E-Mail-Server von {{ settings.application_name }} gesendet.</p>
<p style="margin:0 0 4px;">Sie ist angekommen. Dieser Server kann die E-Mails der Anwendung versenden:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#f6f6f6" style="padding:10px 14px;background:#f6f6f6;border:1px solid #cecece;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#161616;">{% for part in hostParts %}{{ part }}{% if not loop.last %}.<wbr>{% endif %}{% endfor %}</td></tr></table>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#666666;">Sie haben nichts getestet? Vielleicht hat es ein anderer Administrator für Sie getan. Sie können diese Nachricht ignorieren.</p>
{% endblock %}
