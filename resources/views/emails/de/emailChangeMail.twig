{% extends 'emails/layout' %}

{% block subject %}Bestätigen Sie Ihre neue Adresse{% endblock %}

{% block header %}Neue Adresse{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Hallo {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Sie möchten diese Adresse für Ihr Konto bei {{ settings.application_name }} verwenden.</p>
<p style="margin:0 0 10px;">Geben Sie diesen Code in Ihrem Profil ein, um sie zu bestätigen:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#f6f6f6" style="padding:14px 22px;background:#f6f6f6;border:1px solid #cecece;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#161616;">{{ code }}</td></tr></table>
<p style="margin:0 0 10px;">Dieser Code läuft in 15 Minuten ab. Bis dahin behält Ihr Konto seine bisherige Adresse.</p>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#666666;">Sie haben das nicht angefordert? Dann ignorieren Sie diese E-Mail: Es ändert sich nichts.</p>
{% endblock %}
