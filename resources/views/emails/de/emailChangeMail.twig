{% extends 'emails/layout' %}

{% block subject %}Bestätigen Sie Ihre neue Adresse{% endblock %}

{% block header %}Neue Adresse{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hallo {{ user.name }},</h2>
<p style="margin:0 0 10px;">Sie möchten diese Adresse für Ihr Konto bei {{ settings.application_name }} verwenden.</p>
<p style="margin:0 0 10px;">Geben Sie diesen Code in Ihrem Profil ein, um sie zu bestätigen:</p>
<p style="margin:20px 0;"><span style="display:inline-block;padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 10px;">Dieser Code läuft in 15 Minuten ab. Bis dahin behält Ihr Konto seine bisherige Adresse.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Sie haben das nicht angefordert? Dann ignorieren Sie diese E-Mail: Es ändert sich nichts.</p>
{% endblock %}
