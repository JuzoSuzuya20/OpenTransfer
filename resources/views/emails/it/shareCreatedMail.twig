{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} ti ha inviato dei file{% endblock %}

{% block header %}File da scaricare{% endblock %}

{% block content %}
<p style="margin:0 0 4px;color:#929292;">{{ sender_name }} ti ha inviato</p>
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">{{ share.name }}</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;">
  <tr><td style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#929292;">Elementi</td><td align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#ffffff;">{{ share.file_count }}</td></tr>
  <tr><td style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#929292;">Dimensione</td><td align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#8585f6;">{{ share_size }}</td></tr>
  <tr><td style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#929292;">Disponibile fino al</td><td align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#ffffff;">{{ share.expires_at|date(layout.date_format) }}</td></tr>
</table>
{% if share.description %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;"><tr><td style="padding:16px 0 0;"><p style="margin:0 0 8px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Messaggio di {{ sender_name }}</p><p style="margin:0;color:#cecece;">{{ share.description|nl2br }}</p></td></tr></table>{% endif %}
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Scarica i file{% endblock %}
