{% extends 'emails/layout' %}

{% block subject %}La tua condivisione scade a breve{% endblock %}

{% block header %}Scadenza imminente{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Ciao {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">La tua condivisione «{{ share.name }}» scade tra {{ share_expires_in }}.</p>
<p style="margin:0 0 12px;">Prolungala da Le mie condivisioni se necessario.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Apri Le mie condivisioni{% endblock %}
