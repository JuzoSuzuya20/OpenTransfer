{% extends 'emails/layout' %}

{% block subject %}Il tuo codice di verifica{% endblock %}

{% block header %}Verifica dell’indirizzo{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Ciao {{ user.name }},</h2>
<p style="margin:0 0 12px;">Grazie per aver creato un account su {{ settings.application_name }}.</p>
<p style="margin:0 0 12px;">Inserisci questo codice per attivare il tuo account:</p>
<p style="margin:20px 0;text-align:center;"><span style="display:inline-block;padding:16px 28px;background:#242424;border:1px solid #353535;border-radius:6px;font-size:30px;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 12px;">Questo codice scade tra 15 minuti.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Non hai creato un account? Puoi ignorare questa e-mail.</p>
{% endblock %}
