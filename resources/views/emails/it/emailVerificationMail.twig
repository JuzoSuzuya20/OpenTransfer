{% extends 'emails/layout' %}

{% block subject %}Il tuo codice di verifica{% endblock %}

{% block header %}Verifica dell’indirizzo{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Ciao {{ user.name }},</h2>
<p style="margin:0 0 10px;">Grazie per aver creato un account su {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Inserisci questo codice per attivare il tuo account:</p>
<p style="margin:20px 0;"><span style="display:inline-block;padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 10px;">Questo codice scade tra 15 minuti.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Non hai creato un account? Puoi ignorare questa e-mail.</p>
{% endblock %}
