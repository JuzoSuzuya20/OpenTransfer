{% extends 'emails/layout' %}

{% block subject %}E-mail di prova da {{ settings.application_name }}{% endblock %}

{% block header %}Server di posta{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Ciao {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Questo messaggio è stato inviato da Amministrazione > Server di posta di {{ settings.application_name }}.</p>
<p style="margin:0 0 4px;">È arrivato. Questo server può inviare le e-mail dell’applicazione:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td bgcolor="#242424" style="padding:10px 14px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#ffffff;">{{ host }}</td></tr></table>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Non hai provato nulla? Forse un altro amministratore l’ha fatto al posto tuo. Puoi ignorare questo messaggio.</p>
{% endblock %}
