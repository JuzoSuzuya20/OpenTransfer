{% extends 'emails/layout' %}

{% block subject %}La tua condivisione sarà eliminata a breve{% endblock %}

{% block header %}Eliminazione imminente{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Ciao {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">La tua condivisione «{{ share.name }}» sarà eliminata tra {{ deletes_in }}.</p>
<table class="ot-l-soft" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #e5e5e5;">
  <tr><td class="ot-c-muted" style="padding:12px 0 0;font-size:14px;line-height:1.5;color:#666666;">Download</td><td class="ot-c-head" align="right" style="padding:12px 0 0 12px;font-size:14px;line-height:1.5;font-weight:800;color:#161616;">{{ share.download_count }}</td></tr>
</table>
<p style="margin:0 0 10px;">Prolungala da Le mie condivisioni per conservarla.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Apri Le mie condivisioni{% endblock %}
