{% extends 'emails/layout' %}

{% block subject %}Reimposta la tua password{% endblock %}

{% block header %}Password{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Ciao {{ user.name }},</h2>
<p style="margin:0 0 12px;">Abbiamo ricevuto una richiesta di reimpostazione della tua password.</p>
<p style="margin:0 0 12px;">Il pulsante qui sotto ti permette di sceglierne una nuova.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Non hai chiesto nulla? Ignora questa e-mail: la tua password non cambia.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Scegli una nuova password{% endblock %}
