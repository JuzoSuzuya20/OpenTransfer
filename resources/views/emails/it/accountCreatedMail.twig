{% extends 'emails/layout' %}

{% block subject %}Il tuo account {{ settings.application_name }} è pronto{% endblock %}

{% block header %}Account creato{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Ciao {{ user.name }},</h2>
<p style="margin:0 0 10px;">È stato creato un account per te su {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Scegli la tua password per iniziare.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Scegli la password{% endblock %}
