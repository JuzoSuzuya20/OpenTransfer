{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} ti chiede dei file{% endblock %}

{% block header %}Richiesta di file{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Ciao {{ recipient_name }},</h2>
<p style="margin:0 0 10px;">{{ sender_name }} ti chiede di inviargli dei file.</p>
{% if isExistingUser %}<p style="margin:0 0 10px;">Accedi per caricarli.</p>{% else %}<p style="margin:0 0 10px;">Accetta la richiesta per caricarli, senza creare un account.</p>{% endif %}
{% if invite.message %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;"><tr><td style="padding:16px 0 0;"><p style="margin:0 0 8px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Messaggio di {{ sender_name }}</p><p style="margin:0;color:#cecece;">{{ invite.message|nl2br }}</p></td></tr></table>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Accedi e carica{% else %}Accetta la richiesta{% endif %}{% endblock %}
