<!DOCTYPE html>
<html lang="{{ emailLocale|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{% if block('subject') is defined %}{{ block('subject')|trim }}{% else %}{{ settings.application_name }}{% endif %}</title>
{# The values of the application (resources/js/style.scss, dark scheme): page #161616, card #1e1e1e,
   line #353535, text #cecece, muted #929292, accent #6a6af4 and its text #8585f6, Plus Jakarta Sans.
   The typeface comes from the instance itself; Gmail and Outlook on Windows ignore it and fall back. #}
<style>
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('{{ settings.application_url }}/build/email/plus-jakarta-sans-latin-ext-wght-normal.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('{{ settings.application_url }}/build/email/plus-jakarta-sans-latin-wght-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  :root { color-scheme: dark; supported-color-schemes: dark; }
  body { margin: 0; padding: 0; background: #161616; }
  a { color: #8585f6; text-decoration: none; }
  .ot-content h2 { margin: 0 0 12px; font-size: 26px; line-height: 1.2; font-weight: 800; color: #ffffff; }
  .ot-content p { margin: 0 0 10px; }
  @media (max-width: 620px) {
    .ot-card-body { padding: 18px 16px !important; }
    .ot-content h2 { font-size: 22px !important; }
  }
</style>
<!--[if mso]>
<style>body, table, td, p, a, span, h2 { font-family: 'Segoe UI', Arial, sans-serif !important; }</style>
<![endif]-->
</head>
<body style="margin:0;padding:0;background:#161616;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#161616" style="background:#161616;">
  <tr>
    <td align="center" style="padding:28px 16px 32px;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
        <tr>
          <td style="padding:0 0 20px;">
            <a href="{{ settings.application_url }}" style="text-decoration:none;">
            {% if brand.custom_logo|default(false) %}
              <img src="{{ settings.application_url }}/images/logo.png" width="{{ brand.logo_width }}" alt="{{ settings.application_name }}" style="display:block;width:{{ brand.logo_width }}px;max-width:100%;height:auto;max-height:40px;border:0;">
            {% else %}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="28" style="width:28px;"><img src="{{ settings.application_url }}/build/email/brand-mark.png" width="28" height="28" alt="" style="display:block;width:28px;height:28px;border:0;"></td>
                  <td style="padding-left:10px;font-size:19px;line-height:28px;font-weight:800;letter-spacing:0.02em;text-transform:uppercase;color:#ffffff;">{{ settings.application_name }}</td>
                </tr>
              </table>
            {% endif %}
            </a>
          </td>
        </tr>
        <tr>
          <td>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#1e1e1e" style="background:#1e1e1e;border:1px solid #353535;border-radius:6px;border-collapse:separate;">
              <tr>
                <td class="ot-card-body" style="padding:20px;">
                  <p style="margin:0 0 16px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">{{ block('header')|trim }}</p>
                  <div class="ot-content" style="font-size:14px;line-height:1.5;color:#cecece;">{{ block('content') }}</div>
                  {% if block('action_url') is defined %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;">
                    <tr>
                      <td bgcolor="#6a6af4" style="background:#6a6af4;border-radius:4px;">
                        <a href="{{ block('action_url')|trim }}" style="display:inline-block;padding:14px 18px;color:#ffffff;text-decoration:none;font-size:13px;line-height:14px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;">{{ block('action_text')|trim }}</a>
                      </td>
                    </tr>
                  </table>
                  <p style="margin:16px 0 2px;font-size:12px;line-height:1.5;color:#929292;">{{ layout.fallback|default('') }}</p>
                  <p style="margin:0;font-size:12px;line-height:1.5;word-break:break-all;"><a href="{{ block('action_url')|trim }}" style="color:#8585f6;text-decoration:none;">{{ block('action_url')|trim }}</a></p>
                  {% endif %}
                </td>
              </tr>
              {# The signature of the identity: the 3 px accent line at the foot of every card #}
              <tr>
                <td height="3" bgcolor="#6a6af4" style="height:3px;padding:0;font-size:0;line-height:3px;background:#6a6af4;border-radius:0 0 5px 5px;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:20px 0 0;font-size:13px;line-height:1.5;color:#929292;">
            {{ layout.footer|default('') }} <a href="{{ settings.application_url }}" style="color:#ffffff;text-decoration:none;font-weight:700;">{{ settings.application_name }}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
