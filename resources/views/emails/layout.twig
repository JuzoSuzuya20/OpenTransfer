<!DOCTYPE html>
<html lang="{{ emailLocale|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{% if block('subject') is defined %}{{ block('subject')|trim }}{% else %}{{ settings.application_name }}{% endif %}</title>
<style>
  :root { color-scheme: dark; supported-color-schemes: dark; }
  body { margin: 0; padding: 0; background: #161616; }
  a { color: #8585f6; }
  .ot-content h2 { margin: 0 0 12px; font-size: 22px; line-height: 1.3; font-weight: 800; color: #ffffff; }
  .ot-content p { margin: 0 0 12px; }
  @media (max-width: 620px) {
    .ot-card { padding: 22px 18px 24px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#161616;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#161616" style="background:#161616;">
  <tr>
    <td align="center" style="padding:32px 16px;font-family:'Plus Jakarta Sans',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
        <tr>
          <td style="padding:0 2px 18px;">
            <a href="{{ settings.application_url }}" style="color:#ffffff;text-decoration:none;font-size:17px;font-weight:800;letter-spacing:0.02em;text-transform:uppercase;">{{ settings.application_name }}</a>
          </td>
        </tr>
        <tr>
          <td class="ot-card" bgcolor="#1e1e1e" style="background:#1e1e1e;border:1px solid #353535;border-bottom:3px solid #6a6af4;border-radius:6px;padding:28px 28px 30px;">
            <p style="margin:0 0 14px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">{{ block('header')|trim }}</p>
            <div class="ot-content" style="font-size:15px;line-height:1.6;color:#cecece;">{{ block('content') }}</div>
            {% if block('action_url') is defined %}
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 4px;">
              <tr>
                <td bgcolor="#6a6af4" style="background:#6a6af4;border-radius:4px;">
                  <a href="{{ block('action_url')|trim }}" style="display:inline-block;padding:13px 22px;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;">{{ block('action_text')|trim }}</a>
                </td>
              </tr>
            </table>
            <p style="margin:18px 0 4px;font-size:12px;line-height:1.5;color:#929292;">{{ layout.fallback|default('') }}</p>
            <p style="margin:0;font-size:12px;line-height:1.5;word-break:break-all;"><a href="{{ block('action_url')|trim }}" style="color:#8585f6;">{{ block('action_url')|trim }}</a></p>
            {% endif %}
          </td>
        </tr>
        <tr>
          <td style="padding:18px 2px 0;font-size:12px;line-height:1.5;color:#929292;">
            {{ layout.footer|default('') }} <a href="{{ settings.application_url }}" style="color:#cecece;text-decoration:none;font-weight:700;">{{ settings.application_name }}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
