{% extends 'emails/layout' %}

{% block subject %}Votre partage expire bientôt{% endblock %}

{% block header %}Expiration prochaine{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Bonjour {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">Votre partage « {{ share.name }} » expire dans {{ share_expires_in }}.</p>
<p style="margin:0 0 10px;">Prolongez-le depuis Mes partages si besoin.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/my-shares{% endblock %}

{% block action_text %}Ouvrir Mes partages{% endblock %}
