{% extends 'emails/layout' %}

{% block subject %}E-mail de test de {{ settings.application_name }}{% endblock %}

{% block header %}Serveur d’e-mails{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Bonjour {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Ce message vous est envoyé depuis Administration > Serveur d’e-mails de {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Il est bien arrivé : le serveur <span style="font-weight:700;">{{ host }}</span> peut envoyer les e-mails de l’application.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Vous n’avez rien testé ? Un autre administrateur l’a peut-être fait à votre place. Vous pouvez ignorer ce message.</p>
{% endblock %}
