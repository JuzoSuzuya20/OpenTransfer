{% extends 'emails/layout' %}

{% block subject %}E-mail de test de {{ settings.application_name }}{% endblock %}

{% block header %}Serveur d’e-mails{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Bonjour {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">Ce message vous est envoyé depuis Administration > Serveur d’e-mails de {{ settings.application_name }}.</p>
<p style="margin:0 0 4px;">Il est bien arrivé. Ce serveur peut envoyer les e-mails de l’application :</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#242424" style="padding:10px 14px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#ffffff;">{{ host }}</td></tr></table>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Vous n’avez rien testé ? Un autre administrateur l’a peut-être fait à votre place. Vous pouvez ignorer ce message.</p>
{% endblock %}
