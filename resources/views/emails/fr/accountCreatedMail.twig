{% extends 'emails/layout' %}

{% block subject %}Votre compte {{ settings.application_name }} est prêt{% endblock %}

{% block header %}Compte créé{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Bonjour {{ user.name }},</h2>
<p style="margin:0 0 10px;">Un compte a été créé pour vous sur {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Choisissez votre mot de passe pour commencer.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Choisir mon mot de passe{% endblock %}
