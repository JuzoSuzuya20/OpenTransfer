{% extends 'emails/layout' %}

{% block subject %}Réinitialiser votre mot de passe{% endblock %}

{% block header %}Mot de passe{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Bonjour {{ user.name }},</h2>
<p style="margin:0 0 12px;">Nous avons reçu une demande de réinitialisation de votre mot de passe.</p>
<p style="margin:0 0 12px;">Le bouton ci-dessous vous permet d’en choisir un nouveau.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Vous n’avez rien demandé ? Ignorez ce message : votre mot de passe ne change pas.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Choisir un nouveau mot de passe{% endblock %}
