{% extends 'emails/layout' %}

{% block subject %}Votre partage a été téléchargé{% endblock %}

{% block header %}Partage téléchargé{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Bonjour {{ share.user.first_name }},</h2>
<p style="margin:0 0 10px;">Votre partage « {{ share.name }} » vient d’être téléchargé.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">Ce message n’est envoyé qu’au premier téléchargement.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Voir le partage{% endblock %}
