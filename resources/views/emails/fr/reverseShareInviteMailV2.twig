{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} vous demande des fichiers{% endblock %}

{% block header %}Demande de fichiers{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Bonjour {{ recipient_name }},</h2>
<p style="margin:0 0 12px;">{{ sender_name }} vous demande de lui envoyer des fichiers.</p>
{% if isExistingUser %}<p style="margin:0 0 12px;">Connectez-vous pour les déposer.</p>{% else %}<p style="margin:0 0 12px;">Acceptez la demande pour les déposer, sans créer de compte.</p>{% endif %}
{% if invite.message %}<div style="margin:16px 0 4px;padding:12px 14px;background:#242424;border-left:3px solid #6a6af4;border-radius:0 6px 6px 0;"><p style="margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Message de {{ sender_name }}</p><p style="margin:0;white-space:pre-line;color:#cecece;">{{ invite.message }}</p></div>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Se connecter et déposer{% else %}Accepter la demande{% endif %}{% endblock %}
