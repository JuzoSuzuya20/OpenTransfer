{% extends 'emails/layout' %}

{% block subject %}Confirm your new address{% endblock %}

{% block header %}New address{% endblock %}

{% block content %}
<h2 class="ot-c-head" style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#161616;">Hello {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">You asked to use this address for your account on {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Enter this code in your profile to confirm it:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;"><tr><td class="ot-b-field ot-l-field ot-c-head" bgcolor="#f6f6f6" style="padding:14px 22px;background:#f6f6f6;border:1px solid #cecece;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#161616;">{{ code }}</td></tr></table>
<p style="margin:0 0 10px;">This code expires in 15 minutes. Until then, your account keeps its current address.</p>
<p class="ot-c-muted" style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#666666;">You did not ask for this? Ignore this email: nothing changes.</p>
{% endblock %}
