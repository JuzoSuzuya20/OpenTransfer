{% extends 'emails/layout' %}

{% block subject %}Reset your password{% endblock %}

{% block header %}Password{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hello {{ user.name }},</h2>
<p style="margin:0 0 10px;">We received a request to reset your password.</p>
<p style="margin:0 0 10px;">The button below lets you choose a new one.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">You did not ask for anything? Ignore this email: your password does not change.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Choose a new password{% endblock %}
