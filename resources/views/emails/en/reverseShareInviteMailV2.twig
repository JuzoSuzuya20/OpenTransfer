{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} is asking you for files{% endblock %}

{% block header %}File request{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hello {{ recipient_name }},</h2>
<p style="margin:0 0 10px;">{{ sender_name }} is asking you to send them files.</p>
{% if isExistingUser %}<p style="margin:0 0 10px;">Sign in to drop them.</p>{% else %}<p style="margin:0 0 10px;">Accept the request to drop them, no account needed.</p>{% endif %}
{% if invite.message %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;border-top:1px solid #2a2a2a;"><tr><td style="padding:16px 0 0;"><p style="margin:0 0 8px;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Message from {{ sender_name }}</p><p style="margin:0;color:#cecece;">{{ invite.message|nl2br }}</p></td></tr></table>{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}Sign in and drop files{% else %}Accept the request{% endif %}{% endblock %}
