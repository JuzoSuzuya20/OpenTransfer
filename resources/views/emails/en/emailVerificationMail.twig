{% extends 'emails/layout' %}

{% block subject %}Your verification code{% endblock %}

{% block header %}Email verification{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hello {{ user.name }},</h2>
<p style="margin:0 0 10px;">Thank you for creating an account on {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Enter this code to activate your account:</p>
<p style="margin:20px 0;"><span style="display:inline-block;padding:14px 22px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:30px;line-height:1.15;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 10px;">This code expires in 15 minutes.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">You did not create an account? You can ignore this email.</p>
{% endblock %}
