{% extends 'emails/layout' %}

{% block subject %}Your verification code{% endblock %}

{% block header %}Email verification{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hello {{ user.name }},</h2>
<p style="margin:0 0 12px;">Thank you for creating an account on {{ settings.application_name }}.</p>
<p style="margin:0 0 12px;">Enter this code to activate your account:</p>
<p style="margin:20px 0;text-align:center;"><span style="display:inline-block;padding:16px 28px;background:#242424;border:1px solid #353535;border-radius:6px;font-size:30px;font-weight:800;letter-spacing:8px;color:#ffffff;">{{ code }}</span></p>
<p style="margin:0 0 12px;">This code expires in 15 minutes.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">You did not create an account? You can ignore this email.</p>
{% endblock %}
