{% extends 'emails/layout' %}

{% block subject %}{{ sender_name }} sent you files{% endblock %}

{% block header %}Files to download{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hello {{ recipient_name }},</h2>
<p style="margin:0 0 12px;">{{ sender_name }} sent you {{ share.file_count }} {{ share.file_count > 1 ? 'files' : 'file' }}.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 4px;border-collapse:separate;border-spacing:0;">
  <tr><td bgcolor="#242424" style="background:#242424;padding:10px 14px;font-size:12px;color:#929292;">Share</td><td bgcolor="#242424" align="right" style="background:#242424;padding:10px 14px;font-size:14px;font-weight:800;color:#ffffff;">{{ share.name }}</td></tr>
  <tr><td bgcolor="#242424" style="background:#242424;padding:10px 14px;font-size:12px;color:#929292;border-top:1px solid #2a2a2a;">Available until</td><td bgcolor="#242424" align="right" style="background:#242424;padding:10px 14px;font-size:14px;font-weight:800;color:#ffffff;border-top:1px solid #2a2a2a;">{{ share.expires_at|date(layout.date_format) }}</td></tr>
</table>
{% if share.description %}<div style="margin:16px 0 4px;padding:12px 14px;background:#242424;border-left:3px solid #6a6af4;border-radius:0 6px 6px 0;"><p style="margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8585f6;">Message from {{ sender_name }}</p><p style="margin:0;white-space:pre-line;color:#cecece;">{{ share.description }}</p></div>{% endif %}
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}Download the files{% endblock %}
