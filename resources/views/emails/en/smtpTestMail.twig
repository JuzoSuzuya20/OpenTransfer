{% extends 'emails/layout' %}

{% block subject %}Test email from {{ settings.application_name }}{% endblock %}

{% block header %}Mail server{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hello {{ user.first_name }},</h2>
<p style="margin:0 0 10px;">This message was sent from Administration > Mail server of {{ settings.application_name }}.</p>
<p style="margin:0 0 4px;">It arrived. This server can send the application’s emails:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px;"><tr><td bgcolor="#242424" style="padding:10px 14px;background:#242424;border:1px solid #3a3a3a;border-radius:4px;font-size:15px;line-height:1.3;font-weight:700;word-break:break-all;color:#ffffff;">{% for part in hostParts %}{{ part }}{% if not loop.last %}.<wbr>{% endif %}{% endfor %}</td></tr></table>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">You did not test anything? Another administrator may have done it for you. You can ignore this message.</p>
{% endblock %}
