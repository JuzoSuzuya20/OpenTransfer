{% extends 'emails/layout' %}

{% block subject %}Your {{ settings.application_name }} account is ready{% endblock %}

{% block header %}Account created{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:26px;line-height:1.2;font-weight:800;color:#ffffff;">Hello {{ user.name }},</h2>
<p style="margin:0 0 10px;">An account was created for you on {{ settings.application_name }}.</p>
<p style="margin:0 0 10px;">Choose your password to get started.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}

{% block action_text %}Choose my password{% endblock %}
