{% extends 'emails/layout' %}

{% block subject %}Your share was downloaded{% endblock %}

{% block header %}Share downloaded{% endblock %}

{% block content %}
<h2 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:800;color:#ffffff;">Hello {{ share.user.first_name }},</h2>
<p style="margin:0 0 12px;">Your share “{{ share.name }}” has just been downloaded.</p>
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#929292;">This email is only sent for the first download.</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}

{% block action_text %}View the share{% endblock %}
