#!/bin/sh

echo "OpenTransfer is starting..."
echo "================================================"

STORAGE=/var/www/html/storage

# Root is only used to fix the ownership of the storage volume, then dropped.
# Started as erugo (user: "1000:1000"), root is never used at all.
if [ "$(id -u)" = "0" ]; then
    as_erugo() { su-exec erugo "$@"; }
else
    as_erugo() { "$@"; }
fi

# Without a mounted volume the image has no storage directory at all: the
# skeleton copy below would fail silently and tusd / the queue worker crash.
mkdir -p "$STORAGE"

if [ "$(id -u)" = "0" ]; then
    # Only what is not already ours: a full chown -R is slow on large volumes
    echo "Checking storage ownership..."
    find "$STORAGE" \( ! -user erugo -o ! -group erugo \) -exec chown erugo:erugo {} +
fi

# First time setup check
if [ ! -f "$STORAGE/.setup-lock" ]; then
    echo "[First time setup] Copying storage skeleton contents..."
    as_erugo sh -c "rm -rf '$STORAGE'/* && cp -r /var/www/html/storage_skell/* '$STORAGE'/ && touch '$STORAGE/.setup-lock'"
else
    echo "Setup already completed, skipping..."

    # Ensure new directories and default images exist for upgrades from older versions
    as_erugo sh -c "
        mkdir -p '$STORAGE/app/backgrounds/cache/thumbs' '$STORAGE/app/public/images'
        for f in _default-logo.png logo.png _default-background.jpg default-background.jpg; do
            [ -f '$STORAGE/app/public/images/'\$f ] || cp /var/www/html/storage_skell/app/public/images/\$f '$STORAGE/app/public/images/'
        done
    "
fi

# Generate the app key and JWT secret on first start
if [ ! -f "$STORAGE/app.key" ]; then
    echo "Generating app key..."
    as_erugo sh -c "php artisan key:generate --force --show > '$STORAGE/app.key'"
fi

if [ ! -f "$STORAGE/jwt.secret" ]; then
    echo "Generating JWT secret..."
    as_erugo sh -c "php -r 'echo base64_encode(random_bytes(32));' > '$STORAGE/jwt.secret'"
fi

# The scheduler runs under supervisord (schedule:work) and inherits this
# environment: no cron, no .env file written into the application code.
. /usr/local/lib/opentransfer-env

# Caddy sits between the reverse proxy and PHP: unless it trusts the same
# proxies, it replaces X-Forwarded-For with the proxy's address before the
# application reads it.
case "$TRUSTED_PROXIES" in
    '*') CADDY_TRUSTED_PROXIES='0.0.0.0/0 ::/0' ;;
    *) CADDY_TRUSTED_PROXIES=$(printf '%s' "$TRUSTED_PROXIES" | tr ',' ' ') ;;
esac
export CADDY_TRUSTED_PROXIES

echo "Running migrations..."
as_erugo php artisan migrate --force

echo "Running seeds..."
as_erugo php artisan db:seed --force

echo "Clearing settings cache..."
as_erugo php artisan clear-settings-cache

echo "Clearing templates cache..."
as_erugo php artisan view:clear

echo "Updating legacy share paths..."
as_erugo php artisan update-legacy-share-paths

# Migrate backgrounds from old storage location (storage/app/public/backgrounds) to new location (storage/app/backgrounds)
if [ -d "$STORAGE/app/public/backgrounds" ] && [ "$(ls -A "$STORAGE/app/public/backgrounds" 2>/dev/null)" ]; then
    echo "Migrating backgrounds from old storage location..."
    as_erugo sh -c "
        mkdir -p '$STORAGE/app/backgrounds/cache/thumbs'
        cp -rn '$STORAGE/app/public/backgrounds/'* '$STORAGE/app/backgrounds/' 2>/dev/null || true
        rm -rf '$STORAGE/app/public/backgrounds'
    "
    echo "Backgrounds migration complete."
fi

# The public/ symlinks into storage are created at build time: the
# application code is owned by root and read-only for erugo.

echo "Starting services..."
if [ "$(id -u)" = "0" ]; then
    # supervisord reopens /dev/stdout and /dev/stderr to relay each service's
    # logs: the container's stdio belongs to root, so hand it to erugo first
    # (started with --user, the runtime already does this itself).
    # (no 2>/dev/null here: it would make /proc/self/fd/2 point at /dev/null)
    chown erugo:erugo /proc/self/fd/1 /proc/self/fd/2 || true
    exec su-exec erugo /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
