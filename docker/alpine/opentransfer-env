# Environment of the application, sourced by start-container and ot-artisan.
# The keys are generated by start-container on first start.

export APP_URL=/
export ASSET_URL=/

STORAGE=/var/www/html/storage

[ -f "$STORAGE/app.key" ] && export APP_KEY="$(cat "$STORAGE/app.key")"
[ -f "$STORAGE/jwt.secret" ] && export JWT_SECRET="$(cat "$STORAGE/jwt.secret")"

if [ -z "$DB_CONNECTION" ]; then
    export DB_CONNECTION=sqlite
    export DB_DATABASE=./storage/app/private/database.sqlite
fi
