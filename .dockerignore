# Contrôle de version et outillage local
.git
.github
.idea
.vscode
.env
.env.*
!.env.example

# Caches des outils de la CI : Trivy y range sa base de failles (1,6 Go) avant la construction de
# l'image publiée, depuis le même dossier (tests/js/dockerignore.test.mjs)
.cache

# Dépendances et artefacts reconstruits dans l'image
node_modules
vendor
public/build
public/hot

# Données locales : ne doivent jamais finir dans une image
storage/app/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
database/*.sqlite*
# The caches Laravel writes on a machine that ran the app: they may name the development tools,
# which the image does not install (package:discover then fails); rebuilt in the image
bootstrap/cache/*.php

# Inutile en production
tests
phpunit.xml
.phpunit.cache
core
core.[0-9]*
docker-compose*.yml
publish-docker-image.sh

# Outils locaux : jamais dans l'image
CLAUDE.md
CLAUDE.local.md
.claude
AGENTS.md
PRODUCT.md
DESIGN.md
.impeccable
.cursor
